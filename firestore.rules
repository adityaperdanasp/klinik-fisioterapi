rules_version = '2';

// Placeholder — akses lewat client SDK belum dipakai sama sekali di app ini
// (semua baca/tulis lewat Admin SDK di server, yang bypass rules ini total).
// Default-deny ini sengaja dikunci sampai Fase 6 (Firestore Security Rules
// per role), JANGAN dilonggarin sebelum itu.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
